# Copy to .env for local runs only. Never commit .env.
# On Render, Vercel and GitHub Actions, set these in the dashboard instead.

# --- Backend (Render) ---
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres   # Supabase pooler connection string
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me                                  # backend only, never in the frontend
SUPABASE_BUCKET=documents

GEMINI_API_KEY=replace-me
GEMINI_MODEL=replace-with-current-flash-model-name
GEMINI_VISION_MODEL=replace-with-current-flash-model-name
GEMINI_EMBED_MODEL=replace-with-current-embedding-model-name
EMBED_DIM=768                                                         # must match the embedding model output
LLM_MAX_CONCURRENCY=2

JWT_SECRET=replace-with-a-long-random-string
DEMO_USERNAME=reviewer
DEMO_PASSWORD=replace-me
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app

MAX_FILE_MB=50
MAX_FILES_PER_BATCH=20
MAX_PDF_PAGES=1500
OCR_CONFIDENCE_THRESHOLD=60
FIELD_CONFIDENCE_THRESHOLD=0.7
MONEY_TOLERANCE=0.01

# --- Frontend (Vercel) ---
NEXT_PUBLIC_API_BASE_URL=https://YOUR-BACKEND.onrender.com
