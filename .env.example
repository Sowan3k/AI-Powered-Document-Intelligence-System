# Copy to .env for local runs only. Never commit .env.
# On Render, Vercel and GitHub Actions, set these in the dashboard instead.

# --- Backend (Render) ---
APP_ENV=production                                                    # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres   # Supabase Session pooler string (IPv4, works from Render)
RUN_MIGRATIONS=true                                                   # start.sh runs alembic upgrade head before starting
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me                                  # backend only, Storage API only (Data API is off)
SUPABASE_BUCKET=documents                                             # private bucket made in the dashboard, 50 MB limit

GEMINI_API_KEY=replace-me
# Model names confirmed against Google's model list on 4 Nov 2026 (DECISIONS.md D31).
GEMINI_MODEL=gemini-3.5-flash-lite                                    # text extraction
GEMINI_VISION_MODEL=gemini-3.8-flash                                  # vision fallback for low-confidence OCR pages
GEMINI_EMBED_MODEL=gemini-embedding-2                                 # no task_type: uses text prefixes (D31)
EMBED_DIM=768                                                         # sent as output_dimensionality; must match vector column
LLM_MAX_CONCURRENCY=2

JWT_SECRET=replace-with-a-long-random-string
DEMO_USERNAME=reviewer
DEMO_PASSWORD=replace-me
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app

MAX_FILE_MB=50                                                        # must not exceed the bucket's 50 MB file limit
MAX_FILES_PER_BATCH=20
MAX_PDF_PAGES=1500
OCR_CONFIDENCE_THRESHOLD=60
FIELD_CONFIDENCE_THRESHOLD=0.7
MONEY_TOLERANCE=0.01
WORKER_POLL_INTERVAL_S=2

# --- Frontend (Vercel) ---
NEXT_PUBLIC_API_BASE_URL=https://YOUR-BACKEND.onrender.com

# --- Local docker-compose only ---
POSTGRES_PASSWORD=replace-me                                          # password for the local db container
